## Postgres
DATABASE_URL=postgres://meridian:meridian@postgres:5432/meridian

## Auth — set to "dev" in alpha to use X-Tenant-Id header instead of JWTs.
## NEVER set to "dev" in production.
AUTH_MODE=dev

## Webhook destination for the seeded endpoint.
## Get a new one at https://webhook.site and paste the URL here.
WEBHOOK_URL=https://webhook.site/00000000-0000-0000-0000-000000000000

## OpenTelemetry — leave SDK disabled until you wire a collector.
## To enable Grafana Cloud / Honeycomb / similar, set the OTLP endpoint and
## flip OTEL_SDK_DISABLED to false.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SDK_DISABLED=true
